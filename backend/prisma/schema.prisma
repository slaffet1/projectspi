generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model banks {
  id             Int         @id @default(autoincrement())
  bank_name      String      @db.VarChar(255)
  account_number String      @db.VarChar(100)
  iban           String?     @db.VarChar(100)
  balance        Decimal?    @default(0) @db.Decimal(15, 2)
  business_id    Int?
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  businesses     businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices       invoices[]
}

model business_users {
  id          Int         @id @default(autoincrement())
  user_id     Int?
  business_id Int?
  role_id     Int?
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  businesses  businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles       roles?      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, business_id])
}

model businesses {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  legal_name         String?              @db.VarChar(255)
  matricule_fiscale  String?              @db.VarChar(100)
  address            String?              @db.VarChar(255)
  city               String?              @db.VarChar(100)
  postal_code        String?              @db.VarChar(20)
  country            String?              @db.VarChar(100)
  phone              String?              @db.VarChar(20)
  email              String?              @db.VarChar(255)
  logo               String?              @db.VarChar(500)
  invoice_prefix     String?              @default("INV-") @db.VarChar(20)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  banks              banks[]
  business_users     business_users[]
  clients            clients[]
  commandes          commandes[]
  expenses           expenses[]
  invitations        invitations[]
  fournisseurs       fournisseurs[]
  products           products[]
  taxes              taxes[]
  join_requests      join_requests[]      @relation("BusinessJoinRequests")
  warehouses         warehouses[]
  inventory_sessions inventory_sessions[]
  credit_notes       credit_notes[]
  purchase_orders    purchase_orders[]
}

model clients {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(20)
  address      String?        @db.VarChar(255)
  city         String?        @db.VarChar(100)
  country      String?        @db.VarChar(100)
  tax_number   String?        @db.VarChar(100)
  business_id  Int?
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @default(now()) @db.Timestamp(6)
  businesses   businesses?    @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotes       quotes[]
  credit_notes credit_notes[]
}

model commande_notes {
  id             Int      @id @default(autoincrement())
  command_number String   @unique @db.VarChar(50)
  command_date   DateTime @db.Date
  quote_id       Int?
  quotes         quotes?  @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model commandes {
  id              Int               @id @default(autoincrement())
  order_number    String            @unique @db.VarChar(50)
  order_date      DateTime          @db.Date
  total_amount    Decimal           @db.Decimal(15, 2)
  product_id      Int?
  business_id     Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  businesses      businesses?       @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products?         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facture_items   facture_items[]
  reception_notes reception_notes[]
}

model fournisseurs {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  email           String?           @db.VarChar(255)
  phone           String?           @db.VarChar(20)
  address         String?           @db.VarChar(255)
  city            String?           @db.VarChar(100)
  country         String?           @db.VarChar(100)
  tax_number      String?           @db.VarChar(100)
  business_id     Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  businesses      businesses?       @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products[]
  purchase_orders purchase_orders[]
}

model delivery_notes {
  id              Int            @id @default(autoincrement())
  delivery_number String         @unique @db.VarChar(50)
  delivery_date   DateTime       @db.Date
  quote_id        Int?
  status          DeliveryStatus @default(PENDING)
  quotes          quotes?        @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_notes    credit_notes[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model expenses {
  id                Int              @id @default(autoincrement())
  label             String           @db.VarChar(255)
  amount            Decimal          @db.Decimal(15, 2)
  expense_date      DateTime         @db.Date
  payment_method    String?          @db.VarChar(50)
  business_id       Int?
  facture_item_id   Int?
  created_at        DateTime?        @default(now()) @db.Timestamp(6)
  businesses        businesses?      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facture_items     facture_items?   @relation(fields: [facture_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order_id Int?
  purchase_orders   purchase_orders? @relation(fields: [purchase_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model facture_items {
  id          Int        @id @default(autoincrement())
  description String     @db.VarChar(255)
  quantity    Int
  unit_price  Decimal    @db.Decimal(15, 2)
  total       Decimal    @db.Decimal(15, 2)
  commande_id Int?
  expenses    expenses[]
  commandes   commandes? @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model inventaires {
  id                 Int       @id @default(autoincrement())
  quantity_available Int
  minimum_quantity   Int?      @default(0)
  last_updated       DateTime? @default(now()) @db.Timestamp(6)
  product_id         Int?
  products           products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model invoices {
  id             Int            @id @default(autoincrement())
  invoice_number String         @unique @db.VarChar(50)
  issue_date     DateTime       @db.Date
  due_date       DateTime       @db.Date
  total_amount   Decimal        @db.Decimal(15, 2)
  bank_id        Int?
  bank           banks?         @relation(fields: [bank_id], references: [id])
  tax_amount     Decimal?       @default(0) @db.Decimal(15, 2)
  status         String?        @default("draft") @db.VarChar(20)
  quote_id       Int?
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  quotes         quotes?        @relation(fields: [quote_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  credit_notes   credit_notes[]
}

model mouvements {
  id             Int            @id @default(autoincrement())
  mouvement_date DateTime       @db.Date
  quantity       Int
  note           String?
  type           mouvement_type
  product_id     Int?
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  products       products?      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model permissions {
  id                Int                 @id @default(autoincrement())
  action            String              @unique @db.VarChar(100)
  roles_permissions roles_permissions[]
}

model products {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  description          String?
  reference            String?                @db.VarChar(100)
  barcode              String?                @db.VarChar(100)
  unit_price           Decimal                @db.Decimal(15, 2)
  cost_price           Decimal?               @db.Decimal(15, 2)
  tax_rate             Decimal?               @default(0) @db.Decimal(5, 2)
  category             String?                @db.VarChar(100)
  unit                 String?                @default("pièce") @db.VarChar(50)
  is_active            Boolean                @default(true)
  business_id          Int?
  fournisseur_id       Int?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  commandes            commandes[]
  inventaires          inventaires[]
  mouvements           mouvements[]
  businesses           businesses?            @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fournisseurs         fournisseurs?          @relation(fields: [fournisseur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quote_details        quote_details[]
  warehouse_products   warehouse_products[]
  inventory_counts     inventory_counts[]
  credit_note_items    credit_note_items[]
  purchase_orders      purchase_orders[]
  purchase_order_items purchase_order_items[]
}

model quote_details {
  id         Int       @id @default(autoincrement())
  quote_id   Int?
  product_id Int?
  quantity   Int
  products   products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotes     quotes?   @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model quotes {
  id              Int              @id @default(autoincrement())
  quote_id        String           @unique @db.VarChar(50)
  issue_date      DateTime         @db.Date
  expiration_date DateTime         @db.Date
  total_amount    Decimal          @db.Decimal(15, 2)
  status          String?          @default("draft") @db.VarChar(20)
  client_id       Int?
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  commande_notes  commande_notes[]
  delivery_notes  delivery_notes[]
  invoices        invoices[]
  quote_details   quote_details[]
  clients         clients?         @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reception_notes {
  id               Int        @id @default(autoincrement())
  reception_number String     @unique @db.VarChar(50)
  reception_date   DateTime   @db.Date
  commande_id      Int?
  commandes        commandes? @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model roles {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar(100)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  business_users    business_users[]
  invitations       invitations[]
  roles_permissions roles_permissions[]
}

model roles_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model users {
  id                       Int              @id @default(autoincrement())
  email                    String           @unique @db.VarChar(255)
  password                 String           @db.VarChar(255)
  firstname                String           @db.VarChar(100)
  lastname                 String           @db.VarChar(100)
  phone_number             String?          @db.VarChar(20)
  status                   String?          @default("active") @db.VarChar(20)
  email_verified           Boolean?         @default(false)
  email_verification_token String?          @db.VarChar(255)
  created_at               DateTime?        @default(now()) @db.Timestamp(6)
  updated_at               DateTime?        @default(now()) @db.Timestamp(6)
  twofa_enabled            Boolean          @default(false)
  twofa_secret             String?
  business_users           business_users[]
  join_requests            join_requests[]  @relation("UserJoinRequests")
}

model taxes {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(100)
  rate        Decimal     @db.Decimal(5, 2)
  description String?     @db.VarChar(255)
  is_default  Boolean?    @default(false)
  business_id Int?
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  businesses  businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model invitations {
  id          Int         @id @default(autoincrement())
  email       String      @db.VarChar(255)
  business_id Int?
  role_id     Int?
  token       String      @unique @db.VarChar(255)
  status      String?     @default("pending") @db.VarChar(20)
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  expires_at  DateTime?   @db.Timestamp(6)
  businesses  businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles       roles?      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum mouvement_type {
  IN
  OUT
  UPDATE
}

model join_requests {
  id          Int        @id @default(autoincrement())
  user_id     Int
  business_id Int
  status      String     @default("pending")
  created_at  DateTime   @default(now())
  user        users      @relation("UserJoinRequests", fields: [user_id], references: [id], onDelete: Cascade)
  business    businesses @relation("BusinessJoinRequests", fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([user_id, business_id])
}

model warehouses {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  location           String?              @db.VarChar(255)
  business_id        Int?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  businesses         businesses?          @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouse_products warehouse_products[]
}

model warehouse_products {
  id           Int        @id @default(autoincrement())
  warehouse_id Int
  product_id   Int
  quantity     Int        @default(0)
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([warehouse_id, product_id])
}

model inventory_sessions {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(255)
  status      String             @default("open") @db.VarChar(20)
  business_id Int?
  created_at  DateTime?          @default(now()) @db.Timestamp(6)
  closed_at   DateTime?
  businesses  businesses?        @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  counts      inventory_counts[]
}

model inventory_counts {
  id                 Int                @id @default(autoincrement())
  session_id         Int
  product_id         Int
  system_quantity    Int
  physical_quantity  Int
  variance           Int
  adjusted           Boolean            @default(false)
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  inventory_sessions inventory_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products           @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum CreditNoteStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model credit_notes {
  id            Int              @id @default(autoincrement())
  credit_number String           @unique @db.VarChar(50)
  return_date   DateTime         @db.Date
  reason        String           @db.VarChar(500)
  note          String?
  total_amount  Decimal          @db.Decimal(15, 2)
  status        CreditNoteStatus @default(DRAFT)

  invoice_id       Int?
  delivery_note_id Int?

  client_id   Int?
  business_id Int?

  created_at DateTime? @default(now()) @db.Timestamp(6)

  invoices       invoices?       @relation(fields: [invoice_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  delivery_notes delivery_notes? @relation(fields: [delivery_note_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  clients        clients?        @relation(fields: [client_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  businesses     businesses?     @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  credit_note_items credit_note_items[]
}

model credit_note_items {
  id             Int     @id @default(autoincrement())
  credit_note_id Int
  product_id     Int
  quantity       Int
  unit_price     Decimal @db.Decimal(15, 2)
  total          Decimal @db.Decimal(15, 2)

  credit_notes credit_notes @relation(fields: [credit_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model purchase_orders {
  id            Int       @id @default(autoincrement())
  order_number  String    @unique @db.VarChar(50)
  order_date    DateTime  @db.Date
  expected_date DateTime? @db.Date
  status        String    @default("DRAFT") @db.VarChar(20) // DRAFT, VALIDATED, CANCELLED
  total_amount  Decimal   @db.Decimal(15, 2)
  notes         String?

  business_id Int?
  supplier_id Int?

  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  businesses   businesses?   @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fournisseurs fournisseurs? @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  items      purchase_order_items[]
  expenses   expenses[]
  products   products?              @relation(fields: [productsId], references: [id])
  productsId Int?
}

model purchase_order_items {
  id                Int     @id @default(autoincrement())
  purchase_order_id Int
  product_id        Int?
  quantity          Int
  unit_price        Decimal @db.Decimal(15, 2)
  total             Decimal @db.Decimal(15, 2)

  purchase_orders purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products?       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
