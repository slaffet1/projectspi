pipeline {
    agent any

    environment {
        NODE_ENV                = 'test'
        PUPPETEER_SKIP_DOWNLOAD = 'true'
        SONAR_TOKEN             = credentials('sonarqube-token')
        SONAR_HOST_URL          = 'http://localhost:9000'
        DB_CONTAINER            = "test-postgres-${env.BUILD_NUMBER}"
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Start Docker Database') {
            steps {
                sh '''
                    echo "=== Starting PostgreSQL container ==="

                    docker rm -f ${DB_CONTAINER} || true

                    sudo systemctl stop postgresql || true

                    docker run -d \
                      --name ${DB_CONTAINER} \
                      -e POSTGRES_USER=saasadmin \
                      -e POSTGRES_PASSWORD=saaspassword \
                      -e POSTGRES_DB=saasplatform \
                      -p 5432:5432 \
                      postgres:16
                '''
            }
        }

        stage('Wait for Database') {
            steps {
                sh '''
                    echo "=== Waiting for PostgreSQL to be ready ==="
                    RETRIES=30
                    COUNT=0
                    until docker exec ${DB_CONTAINER} pg_isready -U saasadmin -d saasplatform; do
                        COUNT=$((COUNT + 1))
                        if [ $COUNT -ge $RETRIES ]; then
                            echo "❌ PostgreSQL did not become ready in time"
                            docker logs ${DB_CONTAINER}
                            exit 1
                        fi
                        echo "Attempt $COUNT/$RETRIES — waiting 2s..."
                        sleep 2
                    done
                    echo "✅ PostgreSQL is ready"
                '''
            }
        }

        stage('Install Backend') {
            steps {
                // ✅ DATABASE_URL défini ici via withEnv, après que Docker est prêt
                withEnv(['DATABASE_URL=postgresql://saasadmin:saaspassword@localhost:5432/saasplatform']) {
                    dir('backend') {
                        sh 'npm ci'
                        sh 'npx prisma generate'
                    }
                }
            }
        }

        stage('Run Migrations') {
            steps {
                withEnv(['DATABASE_URL=postgresql://saasadmin:saaspassword@localhost:5432/saasplatform']) {
                    dir('backend') {
                        sh 'npx prisma migrate deploy'
                    }
                }
            }
        }

        stage('Test Backend') {
            steps {
                withEnv(['DATABASE_URL=postgresql://saasadmin:saaspassword@localhost:5432/saasplatform']) {
                    dir('backend') {
                        sh 'npm run test -- --passWithNoTests --forceExit --coverage || true'
                    }
                }
            }
        }

        stage('Build Backend') {
            steps {
                dir('backend') {
                    sh 'npm run build'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    sh '''
                        npx sonar-scanner \
                          -Dsonar.projectKey=projectspi-backend \
                          -Dsonar.sources=src \
                          -Dsonar.exclusions=node_modules/**,dist/**,coverage/**,**/*.spec.ts \
                          -Dsonar.host.url=${SONAR_HOST_URL} \
                          -Dsonar.token=${SONAR_TOKEN} \
                          -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info
                    '''
                }
            }
        }
    }

    post {
    always {
        sh 'docker rm -f ${DB_CONTAINER} || true'
    }
    success {
        echo '✅ CI Backend réussi'
    }
    failure {
        echo '❌ CI Backend échoué'
        sh 'docker logs ${DB_CONTAINER} || true'
        sh 'docker rm -f ${DB_CONTAINER} || true'
    }
}

}