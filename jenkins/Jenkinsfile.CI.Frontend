pipeline {
    agent any

    environment {
        NODE_ENV = 'development'
        SONAR_TOKEN = credentials('sonarqube-token')
        SONAR_HOST_URL = 'http://localhost:9000'
        DATABASE_URL = 'postgresql://saasadmin:saaspassword@localhost:5432/saasplatform'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Install Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm ci --include=dev'
                }
            }
        }

        stage('Install Backend for Tests') {
            steps {
                dir('backend') {
                    sh 'PUPPETEER_SKIP_DOWNLOAD=true npm ci'
                    sh 'npx prisma generate'
                }
            }
        }

       stage('Start Backend Test Mode') {
    steps {
        dir('backend') {
            withCredentials([
                
                string(credentialsId: 'api-trans', variable: 'API_TRANS'),
                string(credentialsId: 'hf-token', variable: 'HF_TOKEN')
            ]) {
                sh '''
                    echo "Starting backend with all secrets..."

                    export DATABASE_URL=$DATABASE_URL
                    export API_TRANS=$API_TRANS
                    export HF_TOKEN=$HF_TOKEN

                    nohup npm run start:test > backend.log 2>&1 & echo $! > backend.pid

                    sleep 10

                    curl -f http://localhost:3001/health || echo "Backend not ready"

                    head -20 backend.log
                '''
            }
        }
    }
}
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Start Frontend Dev Server') {
            steps {
                dir('frontend') {
                    sh 'nohup npm run dev -- --host 0.0.0.0 > frontend.log 2>&1 & echo $! > frontend.pid'
                    sh 'sleep 15'
                    sh 'curl -f http://localhost:5173 || echo "Frontend not ready"'
                }
            }
        }

        stage('Run Cypress Tests') {
            steps {
                dir('frontend') {
                    sh 'npx cypress run'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    sh '''
                        npx sonar-scanner \
                          -Dsonar.projectKey=projectspi-frontend \
                          -Dsonar.sources=src \
                          -Dsonar.exclusions=node_modules/**,dist/**,coverage/**,**/*.spec.ts,**/*.test.ts,cypress/** \
                          -Dsonar.host.url=${SONAR_HOST_URL} \
                          -Dsonar.token=${SONAR_TOKEN}
                    '''
                }
            }
        }
    }

    post {
        
        success {
            echo 'CI Frontend réussi ✅'
        }
        failure {
            echo 'CI Frontend échoué ❌'
        }
    }
}
