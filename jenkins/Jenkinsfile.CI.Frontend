pipeline {
    agent any

    environment {
        NODE_ENV                = 'test'
        PUPPETEER_SKIP_DOWNLOAD = 'true'
        SONAR_TOKEN             = credentials('sonarqube-token')
        SONAR_HOST_URL          = 'http://localhost:9000'
        DATABASE_URL            = 'postgresql://saasadmin:saaspassword@localhost:5432/saasplatform'
        DB_CONTAINER            = "test-postgres-front-${env.BUILD_NUMBER}"
    }

    triggers {
        upstream(upstreamProjects: 'projectspi-CI-Backend', threshold: hudson.model.Result.SUCCESS)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Start Docker Database') {
            steps {
                sh '''
                    echo "=== Starting PostgreSQL container ==="
                    docker rm -f ${DB_CONTAINER} || true
                    docker run -d \
                      --name ${DB_CONTAINER} \
                      -e POSTGRES_USER=saasadmin \
                      -e POSTGRES_PASSWORD=saaspassword \
                      -e POSTGRES_DB=saasplatform \
                      -p 5432:5432 \
                      postgres:16
                '''
            }
        }

        stage('Wait for Database') {
            steps {
                sh '''
                    echo "=== Waiting for PostgreSQL to be ready ==="
                    RETRIES=30
                    COUNT=0
                    until docker exec ${DB_CONTAINER} pg_isready -U saasadmin -d saasplatform; do
                        COUNT=$((COUNT + 1))
                        if [ $COUNT -ge $RETRIES ]; then
                            echo "❌ PostgreSQL did not become ready in time"
                            docker logs ${DB_CONTAINER}
                            exit 1
                        fi
                        echo "Attempt $COUNT/$RETRIES — waiting 2s..."
                        sleep 2
                    done
                    echo "✅ PostgreSQL is ready"
                '''
            }
        }

        stage('Restore Test Database') {
            steps {
                sh '''
                    echo "=== Restoring test database with seed data ==="
                    docker exec -i ${DB_CONTAINER} psql -U saasadmin -d saasplatform < /home/saidlaffet/saasplatform_backup.sql
                    echo "✅ Database restored"
                '''
            }
        }

        stage('Install Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm ci --include=dev'
                }
            }
        }

        stage('Install Backend for Tests') {
            steps {
                dir('backend') {
                    sh 'PUPPETEER_SKIP_DOWNLOAD=true npm ci'
                    sh 'npx prisma generate'
                }
            }
        }

        stage('Start Backend Test Mode') {
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'api-trans', variable: 'API_TRANS'),
                        string(credentialsId: 'hf-token', variable: 'HF_TOKEN')
                    ]) {
                        sh '''
                            echo "Starting backend with all secrets..."
                            export DATABASE_URL=$DATABASE_URL
                            export API_TRANS=$API_TRANS
                            export HF_TOKEN=$HF_TOKEN
                            nohup npm run start:test > backend.log 2>&1 & echo $! > backend.pid
                            sleep 10
                            curl -f http://localhost:3001/health || echo "Backend not ready"
                            head -20 backend.log
                        '''
                    }
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Start Frontend Dev Server') {
            steps {
                dir('frontend') {
                    sh 'nohup npm run dev -- --host 0.0.0.0 > frontend.log 2>&1 & echo $! > frontend.pid'
                    sh 'sleep 15'
                    sh 'curl -f http://localhost:5173 || echo "Frontend not ready"'
                }
            }
        }

        stage('Run Cypress Tests') {
            steps {
                dir('frontend') {
                    sh 'npx cypress run'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    sh '''
                        npx sonar-scanner \
                          -Dsonar.projectKey=projectspi-frontend \
                          -Dsonar.sources=src \
                          -Dsonar.exclusions=node_modules/**,dist/**,coverage/**,**/*.spec.ts,**/*.test.ts,cypress/** \
                          -Dsonar.host.url=${SONAR_HOST_URL} \
                          -Dsonar.token=${SONAR_TOKEN}
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker rm -f ${DB_CONTAINER} || true'
            sh 'kill $(cat backend/backend.pid) || true'
            sh 'kill $(cat frontend/frontend.pid) || true'
        }
        success {
            echo '✅ CI Frontend réussi'
        }
        failure {
            echo '❌ CI Frontend échoué'
            sh 'docker logs ${DB_CONTAINER} || true'
            sh 'cat backend/backend.log || true'
        }
    }
}