pipeline {
    agent any

    environment {
        DOCKER_IMAGE   = "leffatsaid/projectspi-frontend"
        DOCKER_IMAGE_BACKEND  = "leffatsaid/projectspi-backend"
        DOCKER_TAG     = "latest"
        RESOURCE_GROUP = "projectspi-rg"
        CLUSTER_NAME   = "projectspi-aks"
    }

    triggers {
        upstream(upstreamProjects: 'projectspi-CI-Frontend', threshold: hudson.model.Result.SUCCESS)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "=== Building Frontend Docker Image ==="
                        docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                        echo "✅ Image built successfully"
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "=== Pushing to Docker Hub ==="
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        echo "✅ Image pushed: ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    '''
                }
            }
        }

       stage('Deploy to Azure AKS') {
            steps {
                // Call the Secret File we created in Jenkins and assign it to KUBE_CONFIG
                withCredentials([file(credentialsId: 'aks-kubeconfig', variable: 'KUBE_CONFIG')]) {
                    script {
                        // We use triple double-quotes (""") here so Jenkins can read its own variables inside the shell script
                        sh """
                            # 1. Tell kubectl to use the secure file Jenkins just injected
                            export KUBECONFIG=\$KUBE_CONFIG
                            
                            # 2. Apply the base infrastructure (ensures your Deployment & Service exist)
                            kubectl apply -f k8s/

                            # 3. Force Kubernetes to pull and run the exact image tag the CI just built
                            kubectl set image deployment/backend-deployment backend=${DOCKER_IMAGE_BACKEND}:${DOCKER_TAG}
                            kubectl set image deployment/frontend-deployment frontend=${DOCKER_IMAGE}:${DOCKER_TAG}
                            
                            # 4. Wait to confirm the deployment was successful and didn't crash
                            kubectl rollout status deployment/backend-deployment
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ CD Frontend réussi — frontend déployé sur Azure AKS'
        }
        failure {
            echo '❌ CD Frontend échoué'
            sh 'kubectl describe deployment/frontend-deployment || true'
            sh 'kubectl logs -l app=frontend --tail=50 || true'
        }
    }
}